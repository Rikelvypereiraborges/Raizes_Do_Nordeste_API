{
  "info": {
    "name": "Raizes do Nordeste API",
    "description": "Colecao para testar o fluxo principal da API: autenticacao, produtos, unidades, estoque, pedidos e pagamento mock.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "orderId",
      "value": "1"
    },
    {
      "key": "unitId",
      "value": "1"
    },
    {
      "key": "productId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 - Login cliente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login retornou token', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.token).to.be.a('string');",
              "  pm.collectionVariables.set('token', json.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"cliente@raizes.local\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "02 - Consultar usuario autenticado",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        }
      }
    },
    {
      "name": "03 - Listar unidades",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/unidades",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "unidades"
          ]
        }
      }
    },
    {
      "name": "04 - Listar produtos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/produtos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "produtos"
          ]
        }
      }
    },
    {
      "name": "05 - Criar pedido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Pedido criado', function () {",
              "  pm.response.to.have.status(201);",
              "  const json = pm.response.json();",
              "  pm.collectionVariables.set('orderId', json.data.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"unitId\": {{unitId}},\n  \"canalPedido\": \"TOTEM\",\n  \"itens\": [\n    { \"produtoId\": {{productId}}, \"quantidade\": 2 }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/pedidos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos"
          ]
        }
      }
    },
    {
      "name": "06 - Listar pedidos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pedidos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos"
          ]
        }
      }
    },
    {
      "name": "07 - Consultar pedido",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/pedidos/{{orderId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos",
            "{{orderId}}"
          ]
        }
      }
    },
    {
      "name": "08 - Pagamento mock aprovado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"formaPagamento\": \"MOCK\",\n  \"cardToken\": \"APROVADO\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/pedidos/{{orderId}}/pagamentos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos",
            "{{orderId}}",
            "pagamentos"
          ]
        }
      }
    },
    {
      "name": "09 - Login admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login admin retornou token', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.collectionVariables.set('token', json.token);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@raizes.local\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "10 - Movimentar estoque entrada",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"unitId\": {{unitId}},\n  \"productId\": {{productId}},\n  \"kind\": \"entrada\",\n  \"quantity\": 10\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/estoques/movimentacoes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "estoques",
            "movimentacoes"
          ]
        }
      }
    },
    {
      "name": "11 - Atualizar status do pedido",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"preparando\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/pedidos/{{orderId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos",
            "{{orderId}}",
            "status"
          ]
        }
      }
    },
    {
      "name": "12 - Login invalido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"cliente@raizes.local\",\n  \"password\": \"senha_errada\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      }
    }
  ]
}
